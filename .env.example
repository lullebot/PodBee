# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Anon key only — never put service_role here or on Vercel.
# The pipeline/ ingest tool uses its own SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# env vars (set locally, never committed) — see pipeline/README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — long-tail catalog (every Podcast Index show gets a page; see
# docs/FULL_CATALOG.md). Server-only: never prefix these with NEXT_PUBLIC_.
# Leave empty to keep search/pages catalog-only.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
# Ratings/Listen List on long-tail shows: >= 32 random chars (openssl rand -hex 32).
# Store the same value in Supabase Vault as 'long_tail_signing_secret'.
LONG_TAIL_SIGNING_SECRET=
# 1 = let search engines index long-tail pages (default: noindex).
PODBEE_LONG_TAIL_INDEXABLE=
